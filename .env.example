# Environment Variables for VRPL Website
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration (required for blog system)
DATABASE_URL=postgresql://vrpl_user:your_password@localhost:5432/vrpl_db
POSTGRES_PASSWORD=your_secure_password_here

# JWT Secret (required for admin authentication)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2025
JWT_EXPIRES_IN=7d

# Admin Credentials (for initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_EMAIL=admin@vrpl.com

# Email Configuration (for contact form)
# Uncomment and configure when ready to use
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-specific-password
# EMAIL_TO=vrplvns@gmail.com

# Optional: API Keys (for future integrations)
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
